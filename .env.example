# --- Alpaca (paper keys from https://app.alpaca.markets) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_FEED=iex            # iex (free) | sip (paid)

# --- XTB xAPI (demo account from xtb.com) ---
XTB_USER_ID=
XTB_PASSWORD=
XTB_DEMO=true
XTB_SYMBOL_SUFFIX=.US      # ".US" = CFD symbols, ".US_9" = real stock symbols on most accounts

# --- Risk limits (engine) ---
RISK_MAX_ORDER_NOTIONAL=2000
RISK_MAX_POSITION_QTY=50
RISK_MAX_OPEN_POSITIONS=5
RISK_MAX_DAILY_LOSS=200
RISK_MAX_QUOTE_AGE_SEC=15
